# ============================================================
# Particle Lab v2 — .gitignore
# ============================================================

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
.venv
.venv/
venv
venv/
**/.venv
app/backend/.venv
app/backend/.venv/
*.egg-info/

# ── Node / Next.js ──
node_modules/
.next/
app/frontend/out/
*.tsbuildinfo

# ── Build artifacts ──
dist/
*.app
.build_cache/
AppIcon.iconset/
*.icns.bak

# ── Runtime data / logs / user output ──
logs/
*.log
runs/
dataset/
.streamlit/
app/data/sessions/
app/backend/data/uploads/
app/backend/data/sessions/

# ── Model weights ──
# 기본 가중치 두 개(basic_pt/U-net++, basic_pt/yolo_11)는 저장소에 넣는다: 설치 파일을 만드는 서버가 받아 갈 수 있어야 한다.
# 그 밖의 가중치와, 실행 중에 만들어지는 .pt 사본은 넣지 않는다.
*.pt
*.pth

# ── IDE / editor / agent metadata ──
.vscode/
.idea/
.claude/
*.swp
*.swo
*.bak
*.tmp

# ── OS metadata ──
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── 내보낸 영상 (크기가 커서 저장소에는 넣지 않는다; tools/intro_video.py 로 다시 만들 수 있다) ──
소개자료/*.mp4
